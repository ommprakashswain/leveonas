(di cs:"min-h-screen bg-slate-950 text-slate-100 flex font-sans"
  (di cs:"w-64 border-r border-slate-800 p-6 flex flex-col justify-between hidden md:flex"
    (di cs:"space-y-6"
      (he cs:"text-xl font-bold text-white tracking-tight" "Overview")
      (di cs:"space-y-2 text-sm text-slate-400"
        (di cs:"px-3 py-2 bg-slate-900 text-white rounded-lg font-medium cursor-pointer" "Metrics")
        (di cs:"px-3 py-2 hover:bg-slate-900 hover:text-white rounded-lg transition-colors cursor-pointer" "Streaming Latency")
        (di cs:"px-3 py-2 hover:bg-slate-900 hover:text-white rounded-lg transition-colors cursor-pointer" "DOM Nodes")
        (di cs:"px-3 py-2 hover:bg-slate-900 hover:text-white rounded-lg transition-colors cursor-pointer" "Telemetry")
      )
    )
    (di cs:"text-xs text-slate-500" "v0.5.0 Production")
  )
  (di cs:"flex-1 p-8 space-y-8 overflow-y-auto"
    (he cs:"text-3xl font-bold text-white tracking-tight" "Streaming Performance")
    (di cs:"grid grid-cols-1 md:grid-cols-3 gap-6"
      (ca cs:"bg-slate-900/60 border border-slate-800 p-6 rounded-xl space-y-2"
        (pa cs:"text-xs text-slate-400 uppercase tracking-wider font-semibold" "Time to First Patch")
        (he cs:"text-3xl font-extrabold text-emerald-400" "1.2 ms")
        (pa cs:"text-xs text-slate-500" "Sub-millisecond DOM diffing")
      )
      (ca cs:"bg-slate-900/60 border border-slate-800 p-6 rounded-xl space-y-2"
        (pa cs:"text-xs text-slate-400 uppercase tracking-wider font-semibold" "Wire Compression")
        (he cs:"text-3xl font-extrabold text-indigo-400" "68.4%")
        (pa cs:"text-xs text-slate-500" "S-expression token efficiency")
      )
      (ca cs:"bg-slate-900/60 border border-slate-800 p-6 rounded-xl space-y-2"
        (pa cs:"text-xs text-slate-400 uppercase tracking-wider font-semibold" "Active Sessions")
        (he cs:"text-3xl font-extrabold text-cyan-400" "1,420")
        (pa cs:"text-xs text-slate-500" "Safe sandboxed workers")
      )
    )
  )
)
