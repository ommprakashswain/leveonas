<VUE>
(component:VueDashboard
  (state:temperature 22)
  (reactive:isWarm temperature > 25)
  (di cs:"p-6 bg-slate-900 border border-slate-800 rounded-xl space-y-4 max-w-sm"
    (h2 cs:"text-xl font-bold text-emerald-400" "Vue-LM Climate")
    (pa cs:"text-slate-300 text-sm" "Temperature: {temperature}°C")
    (pa cs:"text-xs text-amber-400" "Status: {isWarm ? 'Warm' : 'Optimal'}")
    (di cs:"flex gap-2"
      (bo cs:"px-3 py-1.5 bg-emerald-500 text-black font-semibold rounded-lg text-xs" oc:"temperature++" "Increase Temp")
      (bo cs:"px-3 py-1.5 bg-slate-700 text-white rounded-lg text-xs" oc:"temperature--" "Decrease Temp")
    )
  )
)
</VUE>
